{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "prefer-native-element": [
      "error",
      {
        "exclude": [
          "progressbar",
          "listbox",
          "combobox"
        ]
      }
    ],
    "long-title": [
      "error",
      {
        "maxlength": 95
      }
    ],
    "form-dup-name": [
      "error",
      {
        "shared": [
          "radio",
          "checkbox",
          "button",
          "reset",
          "submit"
        ]
      }
    ]
  }
}
